{
    "_comment": [
        "Provider set for the cirrus (k3s) deployment — see cirrus/README.md.",
        "OpenRouter plus the DSE-nimbus vLLM endpoint only: no NRP ELLM (the",
        "cluster has no NRP credentials and the NRP endpoint is not the point of",
        "this deployment) and no Anthropic direct.",
        "No `default_provider`: an unrecognized model name returns 400 rather",
        "than silently falling through to a billed provider."
    ],
    "providers": {
        "openrouter": {
            "endpoint": "https://openrouter.ai/api/v1/chat/completions",
            "api_key_env": "OPENROUTER_KEY",
            "models": [
                "anthropic/",
                "mistralai/",
                "amazon/",
                "openai/",
                "qwen/",
                "nvidia/",
                "z-ai/",
                "minimax/",
                "moonshotai/",
                "deepseek/",
                "~"
            ],
            "extra_headers": {
                "HTTP-Referer": "https://llm-proxy.carlboettiger.info",
                "X-Title": "Open LLM Proxy (cirrus)"
            }
        },
        "nimbus": {
            "endpoint": "https://vllm-nimbus.carlboettiger.info/v1/chat/completions",
            "api_key_env": "NIMBUS_API_KEY",
            "models": [
                "qwen"
            ],
            "thinking_models": {
                "qwen": "enable_thinking"
            }
        }
    }
}
