{
  "providers": {
    "nrp": {
      "endpoint": "https://ellm.nrp-nautilus.io/v1/chat/completions",
      "api_key_env": "NRP_API_KEY",
      "models": [],
      "thinking_models": {
        "kimi": "thinking",
        "deepseek-v4-flash": "thinking",
        "qwen3": "enable_thinking",
        "qwen3-small": "enable_thinking",
        "qwen3-4bit": "enable_thinking",
        "glm-5": "enable_thinking",
        "gemma": "enable_thinking",
        "gemma-small-e4b": "enable_thinking"
      },
      "model_prefixes": []
    },
    "openrouter": {
      "endpoint": "https://openrouter.ai/api/v1/chat/completions",
      "api_key_env": "OPENROUTER_KEY",
      "extra_headers": {
        "HTTP-Referer": "https://open-llm-proxy.nrp-nautilus.io",
        "X-Title": "Open LLM Proxy"
      },
      "model_prefixes": [
        "anthropic/",
        "mistralai/",
        "amazon/",
        "openai/",
        "qwen/",
        "nvidia/",
        "z-ai/",
        "minimax/",
        "moonshotai/",
        "deepseek/",
        "xiaomi/",
        "~"
      ],
      "models": [],
      "default_max_tokens": 32768,
      "max_tokens_ceiling": 32768
    },
    "anthropic": {
      "endpoint": "https://api.anthropic.com/v1/chat/completions",
      "api_key_env": "ANTHROPIC_API_KEY",
      "models": [],
      "no_sampling_params": [
        "claude-sonnet-5",
        "claude-opus-4-8",
        "claude-opus-4-7",
        "claude-fable-5",
        "claude-mythos-5"
      ],
      "model_prefixes": [
        "claude-"
      ],
      "models_auth": "x-api-key",
      "default_max_tokens": 32768,
      "max_tokens_ceiling": 32768
    },
    "nimbus": {
      "endpoint": "https://vllm-nimbus.carlboettiger.info/v1/chat/completions",
      "api_key_env": "NIMBUS_API_KEY",
      "models": [
        "qwen"
      ],
      "thinking_models": {
        "qwen": "enable_thinking"
      },
      "model_prefixes": []
    },
    "gemma4-nimbus": {
      "endpoint": "https://gemma4-nimbus.carlboettiger.info/v1/chat/completions",
      "api_key_env": "NIMBUS_API_KEY",
      "models": [
        "gemma4"
      ],
      "model_prefixes": []
    },
    "vllm-cirrus": {
      "endpoint": "https://vllm-cirrus.carlboettiger.info/v1/chat/completions",
      "api_key_env": "NIMBUS_API_KEY",
      "models": [
        "qwen3-8"
      ],
      "thinking_models": {
        "qwen3-8": "enable_thinking"
      },
      "model_prefixes": []
    }
  },
  "default_provider": "nrp",
  "allowed_providers": [
    "nrp",
    "nimbus"
  ],
  "allowed_models": [
    "anthropic/claude-sonnet-5",
    "deepseek/deepseek-v4-flash",
    "deepseek/deepseek-v4-flash-0731",
    "deepseek/deepseek-v4-flash-vision-exp",
    "deepseek/deepseek-v4.1-flash",
    "moonshotai/kimi-k3",
    "xiaomi/mimo-v2.6-flash",
    "xiaomi/mimo-v2.6-pro",
    "z-ai/glm-5.2",
    "z-ai/glm-5.3",
    "~deepseek/deepseek-v4-flash-latest",
    "~google/gemini-flash-latest"
  ]
}
