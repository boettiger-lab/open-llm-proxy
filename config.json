{
  "providers": {
    "nrp": {
      "endpoint": "https://ellm.nrp-nautilus.io/v1/chat/completions",
      "api_key_env": "NRP_API_KEY",
      "discover_models": true,
      "models": [],
      "thinking_models": {
        "kimi": "thinking",
        "deepseek-v4-flash": "thinking",
        "qwen3": "enable_thinking",
        "qwen3-small": "enable_thinking",
        "qwen3-4bit": "enable_thinking",
        "glm-5": "enable_thinking",
        "gemma": "enable_thinking",
        "gemma-small-e4b": "enable_thinking"
      },
      "model_prefixes": []
    },
    "openrouter": {
      "endpoint": "https://openrouter.ai/api/v1/chat/completions",
      "api_key_env": "OPENROUTER_KEY",
      "extra_headers": {
        "HTTP-Referer": "https://open-llm-proxy.nrp-nautilus.io",
        "X-Title": "Open LLM Proxy"
      },
      "model_prefixes": [
        "anthropic/",
        "mistralai/",
        "amazon/",
        "openai/",
        "qwen/",
        "nvidia/",
        "z-ai/",
        "minimax/",
        "moonshotai/",
        "deepseek/",
        "xiaomi/",
        "~"
      ],
      "models": [],
      "default_max_tokens": 32768,
      "max_tokens_ceiling": 32768
    },
    "openrouter-public": {
      "endpoint": "https://openrouter.ai/api/v1/chat/completions",
      "api_key_env": "OPENROUTER_PUBLIC_KEY",
      "extra_headers": {
        "HTTP-Referer": "https://open-llm-proxy.nrp-nautilus.io",
        "X-Title": "Open LLM Proxy"
      },
      "models": [
        "deepseek-or"
      ],
      "model_aliases": {
        "deepseek-or": "deepseek/deepseek-v4.1-flash-1017"
      },
      "model_prefixes": [],
      "fallback_statuses": [
        402,
        403,
        429,
        500,
        502,
        503,
        504
      ],
      "default_max_tokens": 32768,
      "max_tokens_ceiling": 32768
    },
    "openrouter-benchmark": {
      "endpoint": "https://openrouter.ai/api/v1/chat/completions",
      "api_key_env": "OPENROUTER_BENCHMARK_KEY",
      "extra_headers": {
        "HTTP-Referer": "https://open-llm-proxy.nrp-nautilus.io",
        "X-Title": "Open LLM Proxy"
      },
      "models": [],
      "model_prefixes": [],
      "default_max_tokens": 32768,
      "max_tokens_ceiling": 32768
    },
    "nimbus": {
      "endpoint": "https://vllm-nimbus.carlboettiger.info/v1/chat/completions",
      "api_key_env": "NIMBUS_API_KEY",
      "discover_models": true,
      "models": [
        "qwen",
        "nemotron-3.5-lightning",
        "mimo-v2.6-flash",
        "glm-5.3-flash"
      ],
      "thinking_models": {
        "qwen": "enable_thinking",
        "nemotron-3.5-lightning": "enable_thinking",
        "mimo-v2.6-flash": "enable_thinking",
        "glm-5.3-flash": "enable_thinking"
      },
      "model_prefixes": []
    },
    "nimbus2": {
      "endpoint": "https://vllm-nimbus2.carlboettiger.info/v1/chat/completions",
      "api_key_env": "NIMBUS_API_KEY",
      "discover_models": true,
      "models": [
        "deepseek-nimbus"
      ],
      "model_aliases": {
        "deepseek-nimbus": "deepseek-v4-flash"
      },
      "thinking_models": {
        "deepseek-nimbus": "thinking"
      },
      "model_prefixes": []
    },
    "gemma4-nimbus": {
      "endpoint": "https://gemma4-nimbus.carlboettiger.info/v1/chat/completions",
      "api_key_env": "NIMBUS_API_KEY",
      "discover_models": true,
      "models": [
        "gemma4"
      ],
      "model_prefixes": []
    },
    "whisper-cirrus": {
      "endpoint": "https://whisper-cirrus.carlboettiger.info/v1/audio/transcriptions",
      "models_endpoint": "https://whisper-cirrus.carlboettiger.info/v1/models",
      "api": "audio_transcriptions",
      "api_key_env": "NIMBUS_API_KEY",
      "models": [
        "parakeet",
        "whisper-turbo"
      ],
      "model_aliases": {
        "parakeet": "istupakov/parakeet-tdt-0.6b-v3-onnx",
        "whisper-turbo": "deepdml/faster-whisper-large-v3-turbo-ct2"
      },
      "model_prefixes": []
    },
    "vllm-cirrus": {
      "endpoint": "https://vllm-cirrus.carlboettiger.info/v1/chat/completions",
      "api_key_env": "NIMBUS_API_KEY",
      "discover_models": true,
      "models": [
        "qwen3-8"
      ],
      "thinking_models": {
        "qwen3-8": "enable_thinking"
      },
      "model_prefixes": []
    }
  },
  "default_provider": "nrp",
  "tiers": {
    "public": {
      "default_model": "deepseek-v4-flash",
      "transcription_model": "parakeet",
      "models": [
        "deepseek-v4-flash",
        "deepseek-or",
        "glm-5",
        "kimi",
        "qwen3",
        "qwen3-small",
        "gpt-oss",
        "minimax-m2",
        "gemma",
        "gemma-small",
        "deepseek-nimbus"
      ],
      "auto": [
        "nimbus",
        "nimbus2",
        "gemma4-nimbus"
      ]
    },
    "private": {
      "default_model": "deepseek/deepseek-v4.1-flash-1017",
      "transcription_model": "parakeet",
      "models": [
        "deepseek/deepseek-v4.1-flash-1017",
        "deepseek/deepseek-v4.1-flash-1017:nitro",
        "deepseek-v4-flash",
        "gemma",
        "deepseek-nimbus"
      ]
    },
    "benchmark-free": {
      "default_model": "deepseek-v4-flash",
      "upstream_timeout_seconds": 14400,
      "models": [
        "deepseek-v4-flash",
        "glm-5",
        "kimi",
        "qwen3",
        "qwen3-small",
        "gpt-oss",
        "minimax-m2",
        "gemma",
        "gemma-small",
        "deepseek-nimbus"
      ],
      "auto": [
        "nimbus",
        "nimbus2",
        "gemma4-nimbus"
      ]
    },
    "benchmark-paid": {
      "default_model": "deepseek/deepseek-v4.1-flash-1017",
      "upstream_timeout_seconds": 14400,
      "models": [
        "deepseek/deepseek-v4.1-flash-1017",
        "nvidia/nemotron-3.5-super-vl",
        "xiaomi/mimo-v2.6-flash",
        "reflection/beam-1.0-501b-a23b",
        "z-ai/glm-5.3-flash",
        "tencent/hy4-flash",
        "minimax/minimax-m3.1-flash",
        "openai/gpt-6-luna"
      ],
      "provider_overrides": {
        "openrouter": "openrouter-benchmark"
      }
    }
  },
  "models": {
    "deepseek-v4-flash": { "label": "NRP DeepSeek V4 Flash" },
    "glm-5": { "label": "NRP GLM-5.2" },
    "kimi": { "label": "NRP Kimi" },
    "qwen3": { "label": "NRP Qwen3" },
    "qwen3-small": { "label": "NRP Qwen3 Small" },
    "gpt-oss": { "label": "NRP GPT-OSS 120B" },
    "minimax-m2": { "label": "NRP MiniMax M2" },
    "gemma": { "label": "NRP Gemma" },
    "gemma-small": { "label": "NRP Gemma Small" },
    "qwen": { "label": "DSE Qwen3.8 Flash" },
    "deepseek-nimbus": { "label": "DSE DeepSeek V4 Flash" },
    "nemotron-3.5-lightning": { "label": "DSE Nemotron 3.5 Lightning" },
    "mimo-v2.6-flash": { "label": "DSE MiMo V2.6 Flash" },
    "glm-5.3-flash": { "label": "DSE GLM 5.3 Flash" },
    "xiaomi/mimo-v2.6-flash": { "label": "MiMo V2.6 Flash" },
    "deepseek/deepseek-v4.1-flash-1017": { "label": "DeepSeek V4 Flash (1017)" },
    "deepseek/deepseek-v4.1-flash-1017:nitro": { "label": "DeepSeek V4 Flash Nitro (1017)" },
    "deepseek-or": { "label": "DeepSeek V4 Flash (1017)" }
  },
  "fallbacks": {
    "deepseek-v4-flash": "deepseek-nimbus",
    "deepseek-or": [
      "deepseek-v4-flash",
      "deepseek-nimbus"
    ]
  },
  "default_key_tier": "public",
  "primary_key_tier": "public",
  "budgets": {
    "window_hours": 4,
    "count": "completion",
    "per_key": {
      "public": 4000000,
      "private": 4000000
    },
    "per_client": {
      "public": 1000000,
      "private": 1000000
    },
    "per_user": {
      "public": 1000000,
      "private": 1000000
    }
  }
