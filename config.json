{
  "providers": {
    "nrp": {
      "endpoint": "https://ellm.nrp-nautilus.io/v1/chat/completions",
      "api_key_env": "NRP_API_KEY",
      "models": [],
      "thinking_models": {
        "kimi": "thinking",
        "deepseek-v4-flash": "thinking",
        "qwen3": "enable_thinking",
        "qwen3-small": "enable_thinking",
        "qwen3-4bit": "enable_thinking",
        "glm-5": "enable_thinking",
        "gemma": "enable_thinking",
        "gemma-small-e4b": "enable_thinking"
      },
      "model_prefixes": []
    },
    "openrouter": {
      "endpoint": "https://openrouter.ai/api/v1/chat/completions",
      "api_key_env": "OPENROUTER_KEY",
      "extra_headers": {
        "HTTP-Referer": "https://open-llm-proxy.nrp-nautilus.io",
        "X-Title": "Open LLM Proxy"
      },
      "model_prefixes": [
        "anthropic/",
        "mistralai/",
        "amazon/",
        "openai/",
        "qwen/",
        "nvidia/",
        "z-ai/",
        "minimax/",
        "moonshotai/",
        "deepseek/",
        "~"
      ],
      "models": []
    },
    "anthropic": {
      "endpoint": "https://api.anthropic.com/v1/chat/completions",
      "api_key_env": "ANTHROPIC_API_KEY",
      "models": [],
      "no_sampling_params": [
        "claude-sonnet-5",
        "claude-opus-4-8",
        "claude-opus-4-7",
        "claude-fable-5",
        "claude-mythos-5"
      ],
      "model_prefixes": [
        "claude-"
      ],
      "models_auth": "x-api-key"
    },
    "nimbus": {
      "endpoint": "https://vllm-nimbus.carlboettiger.info/v1/chat/completions",
      "api_key_env": "NIMBUS_API_KEY",
      "models": [
        "qwen"
      ],
      "thinking_models": {
        "qwen": "enable_thinking"
      },
      "model_prefixes": []
    },
    "gemma4-nimbus": {
      "endpoint": "https://gemma4-nimbus.carlboettiger.info/v1/chat/completions",
      "api_key_env": "NIMBUS_API_KEY",
      "models": [
        "gemma4"
      ],
      "model_prefixes": []
    },
    "qwen3-cirrus": {
      "endpoint": "https://qwen3-cirrus.carlboettiger.info/v1/chat/completions",
      "api_key_env": "NIMBUS_API_KEY",
      "models": [
        "qwen3-6"
      ],
      "thinking_models": {
        "qwen3-6": "enable_thinking"
      },
      "model_prefixes": []
    }
  },
  "default_provider": "nrp"
}
